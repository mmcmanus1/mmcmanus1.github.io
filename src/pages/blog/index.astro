---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import '../../styles/blog.css';

const posts = await getCollection('blog', ({ data }) => !data.unlisted && (import.meta.env.DEV || !data.draft));
const sortedPosts = posts.sort((a, b) =>
  (a.data.order ?? 100) - (b.data.order ?? 100) || b.data.date.getTime() - a.data.date.getTime()
);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
}
---

<PageLayout title="Blog" description="Blog posts by Matt McManus">
  <h2>Blog</h2>
  <p class="blog-intro">Puzzles, probabilities, and models of the world. Start with a question, work through an example, and see what changes when you turn a knob.</p>

  {sortedPosts.length === 0 ? (
    <p>No posts yet. Check back soon!</p>
  ) : (
    <ul class="post-list">
      {sortedPosts.map((post) => (
        <li>
          <span class="post-date">{post.data.draft ? 'Draft' : formatDate(post.data.date)}</span>
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          {post.data.description && <p>{post.data.description}</p>}
        </li>
      ))}
    </ul>
  )}
</PageLayout>
